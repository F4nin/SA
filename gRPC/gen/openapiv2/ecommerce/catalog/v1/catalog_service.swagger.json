{
  "swagger": "2.0",
  "info": {
    "title": "ecommerce/catalog/v1/catalog_service.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "CatalogService",
      "description": "Сервис каталога товаров.\nПредоставляет операции чтения, создания, обновления и скрытия товаров,\nа также подписку на изменение остатков."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/products": {
      "get": {
        "operationId": "CatalogService_ListProducts",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListProductsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "pageSize",
            "description": "сколько товаров вернуть на одной странице",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "pageToken",
            "description": "токен следующей страницы; пусто для первой страницы",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "categoryId",
            "description": "фильтр по категории",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "description": "фильтр по статусу\n\n - PRODUCT_STATUS_ACTIVE: товар доступен в каталоге\n - PRODUCT_STATUS_HIDDEN: товар скрыт (soft delete)\n - PRODUCT_STATUS_ARCHIVED: товар полностью выведен из каталога",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "PRODUCT_STATUS_UNSPECIFIED",
              "PRODUCT_STATUS_ACTIVE",
              "PRODUCT_STATUS_HIDDEN",
              "PRODUCT_STATUS_ARCHIVED"
            ],
            "default": "PRODUCT_STATUS_UNSPECIFIED"
          },
          {
            "name": "searchQuery",
            "description": "фильтр по названию/описаниию",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "CatalogService"
        ]
      },
      "post": {
        "operationId": "CatalogService_CreateProduct",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateProductResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "Запрос на создание товара.\nКлиент задаёт только данные товара; id и статус задаёт сервер:\nid генерируется, статус устанавливается в PRODUCT_STATUS_ACTIVE.\nidempotency_key обязателен: при повторном запросе с тем же ключом\nсервер вернёт уже созданный товар, а не создаст дубликат.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateProductRequest"
            }
          }
        ],
        "tags": [
          "CatalogService"
        ]
      }
    },
    "/api/v1/products/{productId}": {
      "get": {
        "operationId": "CatalogService_GetProduct",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetProductResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "CatalogService"
        ]
      },
      "patch": {
        "operationId": "CatalogService_UpdateProduct",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateProductResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CatalogServiceUpdateProductBody"
            }
          }
        ],
        "tags": [
          "CatalogService"
        ]
      }
    },
    "/api/v1/products/{productId}/hide": {
      "post": {
        "operationId": "CatalogService_HideProduct",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1HideProductResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CatalogServiceHideProductBody"
            }
          }
        ],
        "tags": [
          "CatalogService"
        ]
      }
    },
    "/api/v1/products/{productId}/stock/stream": {
      "get": {
        "operationId": "CatalogService_WatchStock",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1StockEvent"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1StockEvent"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "productId",
            "description": "id существующего товара",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "CatalogService"
        ]
      }
    }
  },
  "definitions": {
    "CatalogServiceHideProductBody": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        }
      },
      "description": "Запрос на скрытие товара (soft delete).\nКлиент не передаёт целевой статус: сервер сам переводит товар\nв PRODUCT_STATUS_HIDDEN."
    },
    "CatalogServiceUpdateProductBody": {
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/definitions/v1Product"
        },
        "updateMask": {
          "type": "string"
        }
      },
      "description": "Запрос на частичное обновление товара.\nКлиент передаёт только изменяемые поля в product и перечисляет их в\nupdate_mask. Сервер обновляет исключительно указанные поля, а все\nостальные оставляет без изменений.\n\nПолное обновление (принять целый Product и перезаписать всё) опасно:\nклиент может не передать часть полей, и они будут стёрты."
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1CreateProductRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "categoryId": {
          "type": "string"
        },
        "price": {
          "$ref": "#/definitions/v1Money"
        },
        "stockQuantity": {
          "type": "string",
          "format": "int64"
        },
        "idempotencyKey": {
          "type": "string"
        }
      },
      "description": "Запрос на создание товара.\nКлиент задаёт только данные товара; id и статус задаёт сервер:\nid генерируется, статус устанавливается в PRODUCT_STATUS_ACTIVE.\nidempotency_key обязателен: при повторном запросе с тем же ключом\nсервер вернёт уже созданный товар, а не создаст дубликат."
    },
    "v1CreateProductResponse": {
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/definitions/v1Product"
        }
      },
      "description": "Ответ на CreateProductRequest.\nВозвращает созданный товар целиком: со сгенерированным id\nи установленным статусом, чтобы клиенту не нужен был отдельный GetProduct."
    },
    "v1GetProductResponse": {
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/definitions/v1Product"
        }
      },
      "description": "Ответ на GetProductRequest.\nВозвращает полный товар со всеми полями, включая описание.\nЕсли товар не найден или скрыт, возвращается gRPC-статус NOT_FOUND,\nа не поле ошибки внутри ответа."
    },
    "v1HideProductResponse": {
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/definitions/v1Product"
        }
      },
      "description": "Ответ на HideProductRequest.\nВозвращает обновлённый товар целиком, чтобы клиент сразу увидел\nитоговое состояние без дополнительного GetProduct.\n\nОшибки:\n- товар не найден -\u003e NOT_FOUND;\n- товар уже скрыт -\u003e FAILED_PRECONDITION."
    },
    "v1ListProductsResponse": {
      "type": "object",
      "properties": {
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ProductSummary"
          },
          "title": "товары текущей страницы"
        },
        "nextPageToken": {
          "type": "string",
          "title": "токен на следующую страницу; пустой = страниц больше нет"
        }
      },
      "title": "Ответ на запрос ListProductsRequest - возвращает упрощенную версию ProductSummary"
    },
    "v1Money": {
      "type": "object",
      "properties": {
        "amountMinorUnits": {
          "type": "string",
          "format": "int64",
          "title": "сумма в копейках/центах"
        },
        "currencyCode": {
          "type": "string",
          "title": "\"RUB\", \"USD\", \"EUR\""
        }
      },
      "description": "Деньги. Сумма хранится в минимальных денежных единицах (копейки, центы),\nвалюта — по коду ISO 4217.\nНикогда не используем double/float для денег: они теряют точность\nна десятичных дробях."
    },
    "v1Product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "categoryId": {
          "type": "string"
        },
        "price": {
          "$ref": "#/definitions/v1Money"
        },
        "stockQuantity": {
          "type": "string",
          "format": "int64"
        },
        "status": {
          "$ref": "#/definitions/v1ProductStatus"
        }
      },
      "description": "Полная сущность товара в каталоге.\nИспользуется, когда нужны все данные товара: например, при получении\nтовара по id или после создания/обновления."
    },
    "v1ProductStatus": {
      "type": "string",
      "enum": [
        "PRODUCT_STATUS_UNSPECIFIED",
        "PRODUCT_STATUS_ACTIVE",
        "PRODUCT_STATUS_HIDDEN",
        "PRODUCT_STATUS_ARCHIVED"
      ],
      "default": "PRODUCT_STATUS_UNSPECIFIED",
      "description": "Статус товара\nПервое значение всегда 0 и означает \"не задано\" — это значение по умолчанию\nдля любого enum-поля, поэтому оно не может обозначать реальный статус.\n\n - PRODUCT_STATUS_ACTIVE: товар доступен в каталоге\n - PRODUCT_STATUS_HIDDEN: товар скрыт (soft delete)\n - PRODUCT_STATUS_ARCHIVED: товар полностью выведен из каталога"
    },
    "v1ProductSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "categoryId": {
          "type": "string"
        },
        "price": {
          "$ref": "#/definitions/v1Money"
        },
        "stockQuantity": {
          "type": "string",
          "format": "int64"
        },
        "status": {
          "$ref": "#/definitions/v1ProductStatus"
        }
      },
      "title": "Лёгкая карточка товара для вывода списком.\nОтличается от полного Product тем, что не содержит description:\nв списке полное описание не нужно, а лишние поля раздувают ответ"
    },
    "v1StockEvent": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string"
        },
        "oldStockQuantity": {
          "type": "string",
          "format": "int64",
          "title": "остаток до изменения"
        },
        "newStockQuantity": {
          "type": "string",
          "format": "int64",
          "title": "остаток после изменения"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "title": "момент изменения"
        }
      },
      "description": "Событие изменения остатка товара.\nВ потоке WatchStock передаём только изменённые данные, а не весь Product:\nэто экономит трафик и точнее отражает смысл события."
    },
    "v1UpdateProductResponse": {
      "type": "object",
      "properties": {
        "product": {
          "$ref": "#/definitions/v1Product"
        }
      },
      "description": "Ответ на UpdateProductRequest.\nВозвращает обновлённый товар целиком, чтобы клиент сразу видел\nактуальное состояние без дополнительного GetProduct."
    }
  }
}
