{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "guest"
      ]
    },
    "contact": {
      "anyOf": [
        {
          "type": "string",
          "format": "email"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        }
      ]
    }
  },
  "required": [
    "userId",
    "role",
    "contact"
]
}