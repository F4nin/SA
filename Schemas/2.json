{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "fullName": {
        "type": "string",
        "minLength": 1
      },
      "email" : {
        "type": "string",
        "format": "email"
      },
      "phone": {
        "type": "string",
        "pattern": "^[0-9]{10}$"
      },
      "address": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "zipCode": {
            "type": "string",
            "pattern": "^[0-9]{5,6}$"
          }
        },
        "required": ["street", "city", "country"]
      },
      "required": ["fullName", "email", "phone", "address"]
    }
}