{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "address": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "street": {
          "type": "string",
          "minLength": 1
        },
        "zipCode": {
          "type": "string",
          "pattern": "^[0-9]{5,6}$"
        }
      },
      "required": ["city", "street"]
    }
  },
  "properties": {
    "data": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "homeAddress": {
            "$ref": "#/$defs/address"
          },
          "workAddress": {
            "$ref": "#/$defs/address"
          }
        },
        "required": ["id", "name", "email", "homeAddress"]
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "number",
          "minimum": 1,
          "maximum": 200
        },
        "offset": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["limit", "offset", "total"]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["code", "message"]
    }
  },
  "required": ["data", "meta"]
}